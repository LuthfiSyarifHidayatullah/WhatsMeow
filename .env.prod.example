# =====================================================
# Variabel untuk deploy PRODUKSI (dipakai docker-compose.prod.yml)
# =====================================================
# Cara pakai di server:
#   cp .env.prod.example .env
#   lalu isi nilai-nilai di bawah (ganti semua yang bertanda GANTI_...).
#
# PENTING: file .env berisi rahasia — JANGAN di-commit ke git.
# =====================================================

# Domain publik (harus sudah diarahkan DNS A record ke IP server ini).
APP_DOMAIN=chatbot.bengkayangkab.go.id

# Kunci aplikasi Laravel. Buat dengan salah satu cara:
#   docker compose -f docker-compose.prod.yml run --rm backend php artisan key:generate --show
# lalu salin hasilnya (diawali "base64:...") ke sini.
APP_KEY=

# ---------- Database MySQL ----------
# Ganti dengan password yang kuat & acak.
DB_ROOT_PASSWORD=GANTI_dengan_password_root_kuat
DB_DATABASE=siap_bengkayang
DB_USERNAME=siap_user
DB_PASSWORD=GANTI_dengan_password_user_kuat

# ---------- Token bot ----------
# Token rahasia untuk komunikasi backend <-> bot WhatsApp.
# Ganti dengan string acak panjang (mis. hasil: openssl rand -hex 32).
BOT_API_TOKEN=GANTI_dengan_token_acak_panjang
